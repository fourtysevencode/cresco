# Copy to .env (and to backend/.env when running without Docker).

# Generate each with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
TERMINAL_MASTER_KEY=

# Only needed when running the API outside docker-compose
# DATABASE_URL=postgresql+asyncpg://cresco:cresco@localhost:5432/cresco

# AI tutor. Set AI_PROVIDER=fake to run without a key (canned lessons/quizzes).
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=medium

# Read-aloud. "edge" = free Microsoft neural voices, no key needed (default).
# Alternatives: "google" (needs GOOGLE_TTS_API_KEY on a billing-enabled project), "fake", "none".
TTS_PROVIDER=edge
# Optional voice overrides, e.g. {"ta": "ta-IN-ValluvarNeural"} for a male Tamil voice
# EDGE_TTS_VOICES={}
GOOGLE_TTS_API_KEY=
# Optional voice overrides, e.g. {"ta": "ta-IN-Wavenet-A", "kn": "kn-IN-Wavenet-A"}
# GOOGLE_TTS_VOICES={}

TIMEZONE=Asia/Kolkata

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "sin1"
  ],
  "functions": {
    "app/main.py": {
      "maxDuration": 300,
      "excludeFiles": "{tests/**,alembic/**,data/**,dev_server.py}"
    }
  },
  "crons": [
    {
      "path": "/v1/cron/daily",
      "schedule": "30 0 * * *"
    }
  ]
}

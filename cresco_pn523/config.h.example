// Copy to config.h (git-ignored) and fill in. TERMINAL_ID and TERMINAL_SECRET come from the
// dashboard (Admin → Readers → Add reader) or from `python -m app.cli seed-demo`.
#pragma once

#define WIFI_SSID "school-wifi"
#define WIFI_PASSWORD "wifi-password"

// Must be https:// for Vercel (http:// gets a redirect the reader won't follow). No trailing slash.
// For a server on your laptop (same WiFi) use e.g. "http://192.168.1.10:8000".
#define API_BASE "https://cresco-dusky.vercel.app"

#define TERMINAL_ID "00000000-0000-0000-0000-000000000000"
#define TERMINAL_SECRET "paste-the-64-hex-char-secret-here"

// Optional feedback. Set to -1 if not connected.
#define PIN_LED_OK -1      // lights on approved / identified
#define PIN_LED_ERROR -1   // lights on declined / unknown / network error
#define PIN_BUZZER -1      // active buzzer
